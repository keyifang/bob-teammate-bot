# Copy to .env and fill in. .env is gitignored.
#
# There is deliberately no owner identifier here. Ownership is discovered per
# chat at runtime (the inviter, or the first sender in a private chat) and is
# never configured globally.

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Any OpenAI-compatible chat/completions endpoint. Currently OpenRouter.
MODEL_API_KEY=your_model_api_key_here
MODEL_API_URL=https://openrouter.ai/api/v1/chat/completions
MODEL_NAME=nvidia/nemotron-3.5-lightning:free

# Reasoning models bill thinking as completion tokens, so these need headroom
# well above the length of the visible reply.
REPLY_MAX_TOKENS=2000
SUMMARY_MAX_TOKENS=4000

# Free-tier models queue unpredictably, so waits are bounded generously.
REQUEST_TIMEOUT_MS=300000
SLOW_CALL_MS=30000
# The humanizer costs a whole extra model call; skip it for replies that are
# already short and casual. Set HUMANIZE_SKIP_UNDER=false to always run it.
HUMANIZE_MAX_CHARS=400
HUMANIZE_SKIP_UNDER=true

DATABASE_URL=postgresql://user:password@host:5432/bobdb

BOB_NAME=Bob
BOB_USERNAME=BobAssistantBot
HUMANIZE=true
UNSOLICITED_COOLDOWN_MS=45000
RECENT_MESSAGE_WINDOW=20
SUMMARY_TRIGGER_BUFFER=20

PORT=3000
# Public HTTPS URL Telegram will POST updates to.
WEBHOOK_URL=https://your-domain/telegram-webhook
# Random long string. Telegram echoes it back as X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_SECRET=

# owl_research tool endpoint. Leave unset to disable the tool entirely.
OWL_API_URL=
OWL_API_KEY=

# Test-only. Redirects the Telegram API base URL so the e2e suite can run the
# real server process against a local stub instead of api.telegram.org.
# Leave unset in production.
# TELEGRAM_API_BASE=http://127.0.0.1:8080
