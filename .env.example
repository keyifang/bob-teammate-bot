# Copy to .env and fill in. .env is gitignored.
#
# There is deliberately no owner identifier here. Ownership is discovered per
# chat at runtime (the inviter, or the first sender in a private chat) and is
# never configured globally.

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat

DATABASE_URL=postgresql://user:password@host:5432/bobdb

BOB_NAME=Bob
BOB_USERNAME=BobAssistantBot
HUMANIZE=true
UNSOLICITED_COOLDOWN_MS=45000
RECENT_MESSAGE_WINDOW=20
SUMMARY_TRIGGER_BUFFER=20

PORT=3000
# Public HTTPS URL Telegram will POST updates to.
WEBHOOK_URL=https://your-domain/telegram-webhook
# Random long string. Telegram echoes it back as X-Telegram-Bot-Api-Secret-Token.
WEBHOOK_SECRET=

# owl_research tool endpoint. Leave unset to disable the tool entirely.
OWL_API_URL=
OWL_API_KEY=

# Test-only. Redirects the Telegram API base URL so the e2e suite can run the
# real server process against a local stub instead of api.telegram.org.
# Leave unset in production.
# TELEGRAM_API_BASE=http://127.0.0.1:8080
